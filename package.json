{
  "name": "qortium-network",
  "version": "1.4.5",
  "private": true,
  "license": "0BSD",
  "description": "A QDN network topology viewer for Qortium.",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "dev": "vite",
    "preview": "vite preview",
    "qdn:collect": "node scripts/auto-collect.mjs",
    "qdn:auto-publish": "node scripts/auto-publish.mjs",
    "qdn:publish": "node scripts/publish-qdn.mjs",
    "qdn:publish:all": "npm run qdn:publish && npm run qdn:publish:data",
    "qdn:publish:data": "node scripts/publish-topology-data.mjs",
    "test": "vitest run",
    "build:qortal": "tsc --noEmit && vite build --mode qortal --outDir dist-qortal",
    "qdn:publish:qortal": "node scripts/publish-qortal-app.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.1.0",
    "lucide-react": "^0.577.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^6.0.3",
    "vite": "^8.2.2"
  },
  "devDependencies": {
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "circle-flags": "^2.8.3",
    "vitest": "^4.1.11"
  }
}
